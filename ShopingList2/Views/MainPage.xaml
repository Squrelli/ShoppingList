<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShopingList2.Views.MainPage"
             BackgroundColor="#1A1A1A">
    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" Stroke="White" Padding="15" Margin="10" BackgroundColor="#252525">
            <VerticalStackLayout Spacing="10">
                <Entry x:Name="ProductNameEntry" Placeholder="Nazwa produktu" TextColor="White" />
                <Grid ColumnDefinitions="*, *">
                    <Entry x:Name="ProductAmountEntry" Placeholder="Ilość" Keyboard="Numeric" TextColor="White" />
                    <Entry x:Name="ProductUnitEntry" Grid.Column="1" Placeholder="Jednostka" TextColor="White" />
                </Grid>
                <HorizontalStackLayout Spacing="10">
                    <Picker x:Name="CategoryPicker" Title="Wybierz kategorię" TextColor="White" WidthRequest="150" />
                    <Label Text="LUB" VerticalOptions="Center" TextColor="White" />
                    <Entry x:Name="NewCategoryEntry" Placeholder="Nowa kategoria..." TextColor="White" WidthRequest="150" />
                </HorizontalStackLayout>
                <Button Text="DODAJ PRODUKT" Clicked="OnAddProductClicked" BackgroundColor="#512BD4" />
            </VerticalStackLayout>
        </Border>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="CategoriesStack" Padding="10" />
        </ScrollView>
    </Grid>
</ContentPage>